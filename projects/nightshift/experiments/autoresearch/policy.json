{
  "version": 1,
  "filesystem": {
    "includeWorkdir": true,
    "readOnly": ["/usr", "/lib", "/opt", "/proc", "/sys", "/dev/urandom", "/app", "/etc", "/var/log"],
    "readWrite": ["/sandbox", "/tmp", "/dev/null", "/dev/shm"]
  },
  "landlock": { "compatibility": "best_effort" },
  "networkPolicies": {}
}
