# Copy to .env. Every value is optional for the zero-credential hello-canary
# experiment; the sections below are needed only for what they name. `.env` is
# ignored by Git. Never commit credentials.

# --- OpenShell -------------------------------------------------------------
# Leave NIGHTSHIFT_OPENSHELL_GATEWAY empty to use the OpenShell CLI's active
# local gateway and its mTLS material (a Homebrew `openshell` install needs nothing).
NIGHTSHIFT_OPENSHELL_GATEWAY=
NIGHTSHIFT_WORKSPACE=default
# Only for a remote gateway that does not use the CLI's local mTLS files:
# OPENSHELL_TOKEN=
# OPENSHELL_CA_CERT=
# OPENSHELL_CLIENT_CERT=
# OPENSHELL_CLIENT_KEY=
# OPENSHELL_INSECURE=0

# An empty value means "unset": the runtime or experiment default applies.

# --- Agent model -----------------------------------------------------------
# Which key and endpoint the agent uses is decided by the runtime:
#   responses, codex   -> OpenAI Responses API, key in OPENAI_API_KEY
#   claude-code        -> Anthropic API,        key in ANTHROPIC_API_KEY
# Set the key for whichever runtime you run; the others can stay empty. The key
# reaches the sandbox as an OpenShell provider placeholder, never in the clear.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides. Leave empty to use the runtime's default model and
# endpoint. When set, match them to the runtime's API family. NIGHTSHIFT_MODEL_API_KEY
# is the key for a non-default endpoint (for example an OpenAI-compatible
# inference gateway); it is delivered under the runtime's own variable name.
NIGHTSHIFT_MODEL=
NIGHTSHIFT_MODEL_BASE_URL=
NIGHTSHIFT_MODEL_API_KEY=
# Reasoning effort where supported; `none` omits the field for gateways that
# reject it for some models.
NIGHTSHIFT_MODEL_REASONING=medium
# NIGHTSHIFT_MODEL_CREDENTIAL=env injects the raw key as an environment variable
# instead of a provider placeholder. Debugging only; the agent can read it.
# NIGHTSHIFT_MODEL_CREDENTIAL=provider
# Thread context budget for runtimes the driver rotates (responses). Codex and
# claude-code manage their own compaction. Defaults to 128000 tokens at 80%.
# NIGHTSHIFT_MODEL_CONTEXT_WINDOW=128000

# --- Reviewer model (reviewer: model-reviewer) -----------------------------
# Independent of the agent model above. Defaults: OPENAI_API_KEY,
# https://api.openai.com/v1/responses, gpt-5, medium. Any OpenAI
# Responses-compatible endpoint works here. The reviewer reads the experiment
# folder's reviewer.md for what it may grant.
NIGHTSHIFT_REVIEWER_API_KEY=
NIGHTSHIFT_REVIEWER_RESPONSES_URL=
NIGHTSHIFT_REVIEWER_MODEL=
NIGHTSHIFT_REVIEWER_REASONING=

# --- Run controls ------------------------------------------------------------
# Per-turn hang protection in seconds (default 180; experiments and profiles
# may set their own); --turn-timeout overrides.
# NIGHTSHIFT_TURN_TIMEOUT_SECONDS=180

# --- github-policy-review experiment ---------------------------------------
# A DISPOSABLE repository and a fine-grained token with Contents read/write
# scoped to that one repository. The experiment creates real branches and gives
# the challenger agent this token through an OpenShell provider.
NIGHTSHIFT_GITHUB_OWNER=
NIGHTSHIFT_GITHUB_REPO=
NIGHTSHIFT_GITHUB_BRANCH=main
NIGHTSHIFT_GITHUB_TOKEN=

# --- Local paths and ports ---------------------------------------------------
NIGHTSHIFT_RUNS_DIR=./runs
# Host port for the hello-canary listener that the sandbox reaches via
# host.openshell.internal.
NIGHTSHIFT_CANARY_PORT=18080
