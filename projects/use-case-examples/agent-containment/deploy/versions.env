# The only place versions live. Every deploy script sources this file.
K3S_VERSION=v1.31.5+k3s1
HELM_VERSION=v3.17.3
AGENT_SANDBOX_VERSION=v1.0.3
OPENSHELL_VERSION=0.1.4
# Workload image for the sandboxes template: curl, Python, and coding agents.
# TODO: pin by digest before publishing.
SANDBOX_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base:latest

# Stock uv Python image the watchdog pod runs this checkout with (multi-arch).
WATCHDOG_IMAGE=ghcr.io/astral-sh/uv:0.9.30-python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58

# Node labels for the two roles, and the taint that keeps everything but
# sandbox workloads off sandbox nodes.
CONTROL_LABEL=openshell.io/role=control
SANDBOX_LABEL=openshell.io/role=sandboxes
SANDBOX_TAINT=openshell.io/sandboxes-only=true:NoSchedule

# Gateway NodePort on the control node. The operator CLI there reaches it on loopback.
GATEWAY_NODE_PORT=30080
