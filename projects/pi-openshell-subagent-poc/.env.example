OPENSHELL_TOOL_SERVICE_TOKEN=replace-with-a-random-poc-token
OPENSHELL_TOOL_SERVICE_HOST=0.0.0.0
OPENSHELL_TOOL_SERVICE_PORT=8765
OPENSHELL_TOOL_SERVICE_DATABASE=.state/jobs.sqlite3

OPENSHELL_BIN=openshell
OPENSHELL_GATEWAY=openshell
OPENSHELL_WORKSPACE=default
OPENSHELL_CHILD_IMAGE=pi
OPENSHELL_CHILD_PROVIDER=nv-inference
OPENSHELL_CHILD_MODELS_FILE=config/models.json
OPENSHELL_CHILD_WORKDIR=/sandbox

PI_PROVIDER=openshell-inference
PI_MODEL=azure/openai/gpt-5.6-sol
OPENSHELL_CREATE_TIMEOUT_SECONDS=300
OPENSHELL_JOB_TIMEOUT_SECONDS=300
OPENSHELL_DELETE_TIMEOUT_SECONDS=60
