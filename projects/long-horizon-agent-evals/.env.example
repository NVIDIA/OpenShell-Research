# Copy to .env. Every value is optional for the zero-credential hello-canary
# scenario; the sections below are needed only for what they name. `.env` is
# ignored by Git. Never commit credentials.

# --- OpenShell -------------------------------------------------------------
# Leave LAB_OPENSHELL_GATEWAY empty to use the OpenShell CLI's active local
# gateway and its mTLS material (a Homebrew `openshell` install needs nothing).
LAB_OPENSHELL_GATEWAY=
LAB_WORKSPACE=default
# Only for a remote gateway that does not use the CLI's local mTLS files:
# OPENSHELL_TOKEN=
# OPENSHELL_CA_CERT=
# OPENSHELL_CLIENT_CERT=
# OPENSHELL_CLIENT_KEY=
# OPENSHELL_INSECURE=0

# An empty value means "unset": the runtime or scenario default applies.

# --- Agent model -----------------------------------------------------------
# Which key and endpoint the agent uses is decided by the runtime:
#   responses, codex   -> OpenAI Responses API, key in OPENAI_API_KEY
#   claude-code        -> Anthropic API,        key in ANTHROPIC_API_KEY
# Set the key for whichever runtime you run; the others can stay empty. The key
# reaches the sandbox as an OpenShell provider placeholder, never in the clear.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides. Leave empty to use the runtime's default model and
# endpoint. When set, match them to the runtime's API family. LAB_MODEL_API_KEY
# is the key for a non-default endpoint (for example an OpenAI-compatible
# inference server); it is delivered under the runtime's own variable name.
LAB_MODEL=
LAB_MODEL_BASE_URL=
LAB_MODEL_API_KEY=
# Reasoning effort where supported; `none` omits the field for gateways that
# reject it for some models (Opus via a Responses-compatible proxy).
LAB_MODEL_REASONING=medium
# LAB_MODEL_CREDENTIAL=env injects the raw key as an environment variable
# instead of a provider placeholder. Debugging only; the agent can read it.
# LAB_MODEL_CREDENTIAL=provider
# Thread context budget for runtimes the driver rotates (responses). Codex and
# claude-code manage their own compaction. Defaults to 128000 tokens at 80%.
# LAB_MODEL_CONTEXT_WINDOW=128000

# --- Reviewer model (reviewer: model-reviewer) --------------------------
# Independent of the agent model above. Defaults: OPENAI_API_KEY,
# https://api.openai.com/v1/responses, gpt-5, medium. Any OpenAI
# Responses-compatible endpoint works here.
LAB_REVIEWER_API_KEY=
LAB_REVIEWER_RESPONSES_URL=
LAB_REVIEWER_MODEL=
LAB_REVIEWER_REASONING=

# --- Run controls ------------------------------------------------------------
# Per-turn hang protection in seconds (default 180); --turn-timeout overrides.
# LAB_TURN_TIMEOUT_SECONDS=180
# LAB_SUPERVISOR_PROPOSALS=review

# --- github-policy-review scenario -----------------------------------------
# A DISPOSABLE repository and a fine-grained token with Contents read/write
# scoped to that one repository. The scenario creates real branches and gives
# the challenger agent this token through an OpenShell provider.
LAB_GITHUB_OWNER=
LAB_GITHUB_REPO=
LAB_GITHUB_BRANCH=main
LAB_GITHUB_TOKEN=

# --- Local paths and ports ---------------------------------------------------
LAB_RUNS_DIR=./runs
# Host port for the hello-canary listener that the sandbox reaches via
# host.openshell.internal.
LAB_CANARY_PORT=18080
