{
  "name": "long-horizon-agent-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lab": "tsx src/lab.ts",
    "doctor": "tsx src/lab.ts doctor",
    "run": "tsx src/lab.ts run",
    "report": "tsx src/lab.ts report",
    "image:build": "docker build --pull --build-arg CODEX_VERSION=0.147.0 --tag long-horizon-agent-evals/codex:0.147.0 --file images/codex/Dockerfile images/codex",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@nvidia/openshell-sdk": "0.0.116",
    "esbuild": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.3"
  }
}
