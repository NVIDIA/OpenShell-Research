# Existing HTTPS/mTLS gateway registered in your OpenShell CLI (gateway list).
OPENSHELL_GATEWAY=your-gateway
# Required only when models.json declares more than one model.
# PI_MODEL=openrouter/z-ai/glm-5.3-flash
# Key for the provider in models.json (OpenRouter in the supplied example).
# Never copied into the image. Create an OpenRouter key at https://openrouter.ai/settings/keys.
PI_MODEL_API_KEY=your-provider-key
