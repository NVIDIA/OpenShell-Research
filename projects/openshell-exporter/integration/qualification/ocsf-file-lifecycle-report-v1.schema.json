{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA/OpenShell/schemas/qualification/ocsf-file-lifecycle-report-v1.schema.json",
  "title": "OpenShell OCSF file lifecycle qualification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "result", "complete", "run_id", "started_at", "finished_at",
    "candidate", "gateway", "source_manifests", "lifecycle", "metrics", "storage", "reconciliation",
    "hook_sha256", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["passed", "incomplete", "failed"]},
    "complete": {"type": "boolean"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "gateway": {"$ref": "#/$defs/gateway"},
    "source_manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "before_sha256", "after_sha256"],
      "properties": {
        "before": {"$ref": "#/$defs/source_manifest"},
        "after": {"$ref": "#/$defs/source_manifest"},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["natural_daily_rotation", "exporter_restart", "destination_outage"],
      "properties": {
        "natural_daily_rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "new_files", "previous_file", "previous_file_retained", "previous_files_retained", "previous_files_missing", "retention_expired_files", "previous_inodes_stable", "new_inodes_distinct", "new_files_have_records"],
          "properties": {
            "observed": {"type": "boolean"},
            "new_files": {"type": "array", "items": {"type": "string"}},
            "previous_file": {"type": "string"},
            "previous_file_retained": {"type": "boolean"},
            "previous_files_retained": {"type": "array", "items": {"type": "string"}},
            "previous_files_missing": {"type": "array", "items": {"type": "string"}},
            "retention_expired_files": {"type": "array", "items": {"type": "string"}},
            "previous_inodes_stable": {"type": "boolean"},
            "new_inodes_distinct": {"type": "boolean"},
            "new_files_have_records": {"type": "boolean"}
          }
        },
        "exporter_restart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance_before", "instance_after", "observed", "checkpoint_storage_preserved", "queue_storage_preserved", "recovery_storage_preserved"],
          "properties": {
            "instance_before": {"type": "string"},
            "instance_after": {"type": "string"},
            "observed": {"type": "boolean"},
            "checkpoint_storage_preserved": {"type": "boolean"},
            "queue_storage_preserved": {"type": "boolean"},
            "recovery_storage_preserved": {"type": "boolean"}
          }
        },
        "destination_outage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outage_status", "restore_status", "http_503_exercised", "queue_baseline", "queue_during_outage", "queue_after_restart", "queue_final", "retryable_failure_delta", "drained"],
          "properties": {
            "outage_status": {"type": "integer"},
            "restore_status": {"type": "integer"},
            "http_503_exercised": {"type": "boolean"},
            "queue_baseline": {"type": "number", "minimum": 0},
            "queue_during_outage": {"type": "number", "minimum": 0},
            "queue_after_restart": {"type": "number", "minimum": 0},
            "queue_final": {"type": "number", "minimum": 0},
            "retryable_failure_delta": {"type": "number"},
            "drained": {"type": "boolean"}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "outage", "after_restart", "drained"],
      "properties": {
        "baseline": {"$ref": "#/$defs/metric_point"},
        "outage": {"$ref": "#/$defs/metric_point"},
        "after_restart": {"$ref": "#/$defs/metric_point"},
        "drained": {"$ref": "#/$defs/metric_point"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_restart", "after_restart"],
      "properties": {
        "before_restart": {"$ref": "#/$defs/storage_snapshot"},
        "after_restart": {"$ref": "#/$defs/storage_snapshot"}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained_source_records", "unique_delivered_records", "total_deliveries", "duplicate_deliveries", "missing_durable_records", "identity_collisions", "unexpected_deliveries", "replay_keys_stable", "missing_keys"],
      "properties": {
        "retained_source_records": {"type": "integer", "minimum": 0},
        "unique_delivered_records": {"type": "integer", "minimum": 0},
        "total_deliveries": {"type": "integer", "minimum": 0},
        "duplicate_deliveries": {"type": "integer", "minimum": 0},
        "missing_durable_records": {"type": "integer", "minimum": 0},
        "identity_collisions": {"type": "integer", "minimum": 0},
        "unexpected_deliveries": {"type": "integer", "minimum": 0},
        "replay_keys_stable": {"type": "boolean"},
        "missing_keys": {"type": "array", "maxItems": 100, "items": {"type": "string"}}
      }
    },
    "hook_sha256": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image_digest": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "worktree_clean", "bound", "exporter_version", "exporter_image", "config_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "worktree_clean": {"type": "boolean"},
        "bound": {"type": "boolean"},
        "exporter_version": {"type": "string", "minLength": 1},
        "exporter_image": {"$ref": "#/$defs/image_digest"},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "image"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "image": {"$ref": "#/$defs/image_digest"}
      }
    },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "captured_at", "gateway_id", "workspace", "sandbox_id", "acquisition_kind", "source_instance", "source_directory", "file_pattern", "logical_directory", "resolved_directory", "files", "total_records"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "captured_at": {"type": "string", "format": "date-time"},
        "gateway_id": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "sandbox_id": {"type": "string", "minLength": 1},
        "acquisition_kind": {"const": "ocsf.file"},
        "source_instance": {"type": "string", "minLength": 1},
        "source_directory": {"type": "string", "minLength": 1},
        "file_pattern": {"const": "openshell-ocsf.*.log"},
        "logical_directory": {"type": "string", "minLength": 1},
        "resolved_directory": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_manifest"}},
        "total_records": {"type": "integer", "minimum": 1}
      }
    },
    "file_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "local_path", "file_path", "file_path_resolved", "device", "inode", "size", "modified_at", "changed_at", "record_count", "records"],
      "properties": {
        "filename": {"type": "string", "pattern": "^openshell-ocsf\\..+\\.log$"},
        "local_path": {"type": "string", "minLength": 1},
        "file_path": {"type": "string", "minLength": 1},
        "file_path_resolved": {"type": "string", "minLength": 1},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "size": {"type": "integer", "minimum": 1},
        "modified_at": {"type": "string", "format": "date-time"},
        "changed_at": {"type": "string", "format": "date-time"},
        "record_count": {"type": "integer", "minimum": 1},
        "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_record"}}
      }
    },
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_number", "record_offset", "encoded_bytes", "body_sha256", "source", "id", "type"],
      "properties": {
        "record_number": {"type": "integer", "minimum": 1},
        "record_offset": {"type": "integer", "minimum": 0},
        "encoded_bytes": {"type": "integer", "minimum": 1},
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "source": {"type": "string", "pattern": "^openshell://"},
        "id": {"$ref": "#/$defs/sha256"},
        "type": {"type": "string", "pattern": "^com\\.nvidia\\.openshell\\.ocsf\\.(unknown|[0-9]+)\\.v1$"}
      }
    },
    "metric_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "queue_size", "queue_capacity", "retryable_failures", "delivered_events", "metrics_sha256"],
      "properties": {
        "captured_at": {"type": "string", "format": "date-time"},
        "queue_size": {"type": "number", "minimum": 0},
        "queue_capacity": {"type": "number", "minimum": 0},
        "retryable_failures": {"type": "number", "minimum": 0},
        "delivered_events": {"type": "number", "minimum": 0},
        "metrics_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "storage_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "device", "inode", "file_count", "bytes", "manifest_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "storage_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "roles"],
      "properties": {
        "captured_at": {"type": "string", "format": "date-time"},
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoints", "queue", "recovery"],
          "properties": {
            "checkpoints": {"$ref": "#/$defs/storage_role"},
            "queue": {"$ref": "#/$defs/storage_role"},
            "recovery": {"$ref": "#/$defs/storage_role"}
          }
        }
      }
    }
  }
}
