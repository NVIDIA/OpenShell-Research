{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openshell:policy-reconciliation-recovery-report:1.0",
  "title": "OpenShell policy reconciliation recovery qualification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "complete", "candidate", "gateway", "sandbox_id", "actuator", "restart", "reconciliation", "evidence_sets", "metrics", "storage", "privacy", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "complete": {"type": "boolean"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "worktree_clean", "exporter_version", "exporter_image"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "worktree_clean": {"const": true},
        "exporter_version": {"type": "string", "minLength": 1},
        "exporter_image": {"$ref": "#/$defs/image_digest"}
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "image"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "image": {"$ref": "#/$defs/image_digest"}
      }
    },
    "sandbox_id": {"type": "string", "minLength": 1},
    "actuator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_external_actuator", "mutation_id", "expected_policy_version"],
      "properties": {
        "approved_external_actuator": {"const": true},
        "mutation_id": {"type": "string", "minLength": 1},
        "expected_policy_version": {"type": "string", "minLength": 1}
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exporter_identity_before", "exporter_identity_after", "checkpoint_storage_reused"],
      "properties": {
        "exporter_identity_before": {"type": "string", "minLength": 1},
        "exporter_identity_after": {"type": "string", "minLength": 1},
        "checkpoint_storage_reused": {"type": "boolean"}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_types", "observed_new_types", "missing_types", "changed_snapshot_identity_count", "unchanged_snapshot_suppressed", "warning_identity_count", "stable_source_id_pairs_after_repeat", "expected_policy_version_observed", "structurally_valid_event_identities", "observed_consistency_states", "baseline_unique_events", "changed_unique_events", "failure_unique_events", "recovered_unique_events", "raw_deliveries", "delivery_duplicates", "gap_count"],
      "properties": {
        "expected_types": {"$ref": "#/$defs/string_array"},
        "observed_new_types": {"$ref": "#/$defs/string_array"},
        "missing_types": {"$ref": "#/$defs/string_array"},
        "changed_snapshot_identity_count": {"type": "integer", "minimum": 0},
        "unchanged_snapshot_suppressed": {"type": "boolean"},
        "warning_identity_count": {"type": "integer", "minimum": 0},
        "stable_source_id_pairs_after_repeat": {"type": "boolean"},
        "expected_policy_version_observed": {"type": "boolean"},
        "structurally_valid_event_identities": {"type": "boolean"},
        "observed_consistency_states": {"$ref": "#/$defs/string_array"},
        "baseline_unique_events": {"type": "integer", "minimum": 0},
        "changed_unique_events": {"type": "integer", "minimum": 0},
        "failure_unique_events": {"type": "integer", "minimum": 0},
        "recovered_unique_events": {"type": "integer", "minimum": 0},
        "raw_deliveries": {"type": "integer", "minimum": 0},
        "delivery_duplicates": {"type": "integer", "minimum": 0},
        "gap_count": {"type": "integer", "minimum": 0}
      }
    },
    "evidence_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "changed_after_disconnect", "unchanged_repeat", "failure", "recovery"],
      "properties": {
        "baseline": {"$ref": "#/$defs/event_array"},
        "changed_after_disconnect": {"$ref": "#/$defs/event_array"},
        "unchanged_repeat": {"$ref": "#/$defs/event_array"},
        "failure": {"$ref": "#/$defs/event_array"},
        "recovery": {"$ref": "#/$defs/event_array"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "changed", "unchanged", "failure", "recovery"],
      "properties": {
        "baseline": {"$ref": "#/$defs/metric_point"},
        "changed": {"$ref": "#/$defs/metric_point"},
        "unchanged": {"$ref": "#/$defs/metric_point"},
        "failure": {"$ref": "#/$defs/metric_point"},
        "recovery": {"$ref": "#/$defs/metric_point"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/storage_point"},
        "after": {"$ref": "#/$defs/storage_point"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_token_key_leaks"],
      "properties": {"review_token_key_leaks": {"type": "integer", "minimum": 0}}
    },
    "limitations": {"$ref": "#/$defs/string_array"}
  },
  "$defs": {
    "image_digest": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
    "string_array": {"type": "array", "items": {"type": "string"}},
    "event_array": {"type": "array", "items": {"$ref": "#/$defs/event_identity"}},
    "event_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "id", "source_time", "observed_time", "acquisition_kind", "consistency", "policy_version", "warning_code"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_time": {"type": ["string", "null"]},
        "observed_time": {"type": "string", "minLength": 1},
        "acquisition_kind": {"type": "string", "minLength": 1},
        "consistency": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string"},
        "warning_code": {"type": ["string", "null"]}
      }
    },
    "metric_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "captured_at", "successful_reconciliations", "failed_reconciliations", "scrape_sha256"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "successful_reconciliations": {"type": "number", "minimum": 0},
        "failed_reconciliations": {"type": "number", "minimum": 0},
        "scrape_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "storage_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "path", "device", "inode", "file_count", "bytes", "manifest_sha256"],
      "properties": {
        "captured_at": {"type": "string", "format": "date-time"},
        "path": {"type": "string", "minLength": 1},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "file_count": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
