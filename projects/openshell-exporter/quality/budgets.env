# These are regression budgets, not performance or security claims. Raise a
# budget only with measured evidence and maintainer review.
COVERAGE_MIN_PERCENT=70.0
WATCHSANDBOX_COVERAGE_MIN_PERCENT=70.0
CLOUDEVENTS_COVERAGE_MIN_PERCENT=90.0
# gRPC 1.83.2 adds four reviewed indirect modules for Google authentication,
# S2A, enterprise certificate proxying, and GAX. This security baseline fixes
# CVE-2026-84304 while preserving the graph-count regression guard.
GO_MODULE_GRAPH_MAX_COUNT=135
# Collector 0.160 configuration decoding makes the existing confmap dependency
# direct. The measured total graph remains 135; no new module is introduced.
GO_DIRECT_MODULE_MAX_COUNT=28
EXPORTER_OCI_MAX_BYTES=33554432
OTLP_PROXY_OCI_MAX_BYTES=14680064
OCSF_NORMALIZATION_MAX_BYTES_PER_OP=24576
OCSF_NORMALIZATION_MAX_ALLOCS_PER_OP=450
RELAY_ALLOWLIST_MAX_BYTES_PER_OP=5120
RELAY_ALLOWLIST_MAX_ALLOCS_PER_OP=75
CLOUDEVENTS_BATCH_MAX_BYTES_PER_OP=655360
CLOUDEVENTS_BATCH_MAX_ALLOCS_PER_OP=2300
POLICY_CHECKPOINT_MAX_BYTES_PER_OP=2048
POLICY_CHECKPOINT_MAX_ALLOCS_PER_OP=25
POLICY_REVISION_PAGINATION_MAX_BYTES_PER_OP=12288
POLICY_REVISION_PAGINATION_MAX_ALLOCS_PER_OP=16

# Five-second, 250 events/s CI capacity-smoke regression ceilings. These
# include measured shared-runner headroom and are not customer sizing guidance.
CAPACITY_MAX_RSS_BYTES=134217728
CAPACITY_MAX_PROCESS_WRITTEN_BYTES=33554432
CAPACITY_MAX_CHECKPOINT_BYTES=1048576
CAPACITY_MAX_QUEUE_BYTES=8388608
CAPACITY_MAX_RECOVERY_BYTES=16777216
