{
  "version": 1,
  "_meta": {
    "description": "Canonical privacy-filtered OpenShell agent trace index",
    "managed_by": "openshell-event-exporter-reference"
  },
  "index_patterns": [
    "traces-openshell.agent-*-v1"
  ],
  "priority": 600,
  "composed_of": [
    "openshell-agent-trace-ecs-v1"
  ],
  "template": {
    "settings": {
      "index.number_of_shards": 3,
      "index.auto_expand_replicas": "0-1"
    }
  }
}
