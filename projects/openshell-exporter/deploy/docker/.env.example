# core = OpenShell files + WatchSandbox -> CloudEvents + recovery.
# full = core + Relay file/OTLP input -> CloudEvents and OTLP destinations.
# complete = full + native OpenShell OTLP + authenticated sandbox file forwarding.
DOCKER_PROFILE=core
# Build from source with scripts/build-images.sh (use --engine podman for Podman).
OPENSHELL_EXPORTER_IMAGE=localhost/openshell-event-exporter:v0.0.4
# Use missing or always only with your own registry image pinned by @sha256.
OPENSHELL_EXPORTER_PULL_POLICY=never
OPENSHELL_ENDPOINT=https://gateway.example.internal:50051
OPENSHELL_GATEWAY_ID=gateway-stable-id
OPENSHELL_WORKSPACE=default
OPENSHELL_SANDBOX_SELECTOR=
OPENSHELL_LOG_DIR=/srv/openshell/logs
CHECKPOINT_DIR=/srv/openshell-exporter/checkpoints
QUEUE_DIR=/srv/openshell-exporter/cloudevents-queue
RECOVERY_DIR=/srv/openshell-exporter/recovery
# The source directory always contains ca.pem. Keep token when bearer auth is
# enabled; add tls.crt and tls.key when mTLS is enabled. Never disable both.
SOURCE_SECRETS_DIR=./secrets/source
SOURCE_BEARER_ENABLED=true
SOURCE_MTLS_ENABLED=false
OPENSHELL_EXPORT_URL=https://events.example.internal/v1/events
DESTINATION_SECRETS_DIR=./secrets/destination
DESTINATION_MTLS_ENABLED=false

# Full-profile inputs and destinations. These values are ignored by core.
NEMO_RELAY_LOG_DIR=/srv/nemo-relay/logs
NEMO_RELAY_INPUT_SECRETS_DIR=./secrets/nemo-relay-input
NEMO_RELAY_OTLP_GRPC_LISTEN=0.0.0.0:4317
NEMO_RELAY_OTLP_HTTP_LISTEN=0.0.0.0:4318
OTLP_DESTINATION_SECRETS_DIR=./secrets/otlp-destination
OTLP_DESTINATION_MTLS_ENABLED=false
OTLP_GRPC_ENDPOINT=otel.example.internal:4317
OTLP_HTTP_ENDPOINT=https://otel.example.internal:4318
OTLP_GRPC_QUEUE_DIR=/srv/openshell-exporter/otlp-grpc-queue
OTLP_HTTP_QUEUE_DIR=/srv/openshell-exporter/otlp-http-queue

# Complete-profile inputs. These values are ignored by core and full.
# Native OpenShell 0.0.113 OTLP has server TLS but no client-auth setting; keep
# its published address loopback or on a separately isolated network.
OPENSHELL_NATIVE_OTLP_INPUT_SECRETS_DIR=./secrets/native-otlp-input
OPENSHELL_NATIVE_OTLP_GRPC_LISTEN=0.0.0.0:4319
OPENSHELL_NATIVE_OTLP_PUBLISH_ADDRESS=127.0.0.1
# Forwarded sandbox files require bearer auth and mTLS. A one-to-one forwarder
# may reach a reviewed non-loopback address when the host firewall allows it.
FORWARDED_OCSF_INPUT_SECRETS_DIR=./secrets/forwarded-ocsf-input
FORWARDED_OCSF_OTLP_HTTP_LISTEN=0.0.0.0:4320
FORWARDED_OCSF_PUBLISH_ADDRESS=127.0.0.1
