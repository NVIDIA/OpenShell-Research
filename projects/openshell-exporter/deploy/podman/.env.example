# core = files + WatchSandbox; full adds Relay; complete adds native OTLP and forwarded sandbox files.
PODMAN_PROFILE=core
# Build from source with scripts/build-images.sh (use --engine podman for Podman).
OPENSHELL_EXPORTER_IMAGE=localhost/openshell-event-exporter:v0.0.4
# Use missing or always only with your own registry image pinned by @sha256.
OPENSHELL_EXPORTER_PULL_POLICY=never
OPENSHELL_ENDPOINT=https://gateway.example.internal:17670
OPENSHELL_GATEWAY_ID=gateway-stable-id
OPENSHELL_WORKSPACE=default
OPENSHELL_SANDBOX_SELECTOR=
OPENSHELL_LOG_DIR=/srv/openshell/logs
CHECKPOINT_DIR=${HOME}/.local/state/openshell-event-exporter/checkpoints
QUEUE_DIR=${HOME}/.local/state/openshell-event-exporter/cloudevents-queue
RECOVERY_DIR=${HOME}/.local/state/openshell-event-exporter/recovery
# SOURCE_TOKEN_FILE is required only when SOURCE_BEARER_ENABLED=true.
SOURCE_TOKEN_FILE=${HOME}/.config/openshell-event-exporter/source-token
SOURCE_CA_FILE=${HOME}/.config/openshell-event-exporter/source-ca.pem
SOURCE_BEARER_ENABLED=true
OPENSHELL_EXPORT_URL=https://events.example.internal/v1/events
DESTINATION_TOKEN_FILE=${HOME}/.config/openshell-event-exporter/destination-token
DESTINATION_CA_FILE=${HOME}/.config/openshell-event-exporter/destination-ca.pem
OPENSHELL_CLIENT_CERT_FILE=
OPENSHELL_CLIENT_KEY_FILE=
DESTINATION_CLIENT_CERT_FILE=
DESTINATION_CLIENT_KEY_FILE=
MIN_FREE_KIB=1048576
EXPORTER_CPUS=2
EXPORTER_MEMORY=768m
EXPORTER_PIDS_LIMIT=256
EXPORTER_CONTAINER_NAME=openshell-event-exporter

# Full-profile sources and destinations. Ignored by core.
NEMO_RELAY_LOG_DIR=/srv/nemo-relay/logs
NEMO_RELAY_INPUT_SECRETS_DIR=${HOME}/.config/openshell-event-exporter/nemo-relay-input
NEMO_RELAY_OTLP_GRPC_LISTEN=127.0.0.1:4317
NEMO_RELAY_OTLP_HTTP_LISTEN=127.0.0.1:4318
OTLP_DESTINATION_SECRETS_DIR=${HOME}/.config/openshell-event-exporter/otlp-destination
OTLP_GRPC_ENDPOINT=otel.example.internal:4317
OTLP_HTTP_ENDPOINT=https://otel.example.internal:4318
OTLP_DESTINATION_MTLS_ENABLED=false
OTLP_GRPC_QUEUE_DIR=${HOME}/.local/state/openshell-event-exporter/otlp-grpc-queue
OTLP_HTTP_QUEUE_DIR=${HOME}/.local/state/openshell-event-exporter/otlp-http-queue

# Complete-profile inputs. Ignored by core and full.
# OpenShell 0.0.113 native OTLP has no client-auth setting. Keep this on
# loopback or bind it only to an explicitly isolated host address.
OPENSHELL_NATIVE_OTLP_INPUT_SECRETS_DIR=${HOME}/.config/openshell-event-exporter/native-otlp-input
OPENSHELL_NATIVE_OTLP_GRPC_LISTEN=127.0.0.1:4319
# Forwarded sandbox files use bearer authentication plus mTLS and may bind a
# reviewed host address reachable through host.containers.internal.
FORWARDED_OCSF_INPUT_SECRETS_DIR=${HOME}/.config/openshell-event-exporter/forwarded-ocsf-input
FORWARDED_OCSF_OTLP_HTTP_LISTEN=0.0.0.0:4320
