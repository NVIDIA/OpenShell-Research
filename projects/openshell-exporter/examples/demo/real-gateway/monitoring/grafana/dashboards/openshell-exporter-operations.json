    {
      "id": 12,
      "type": "timeseries",
      "title": "Stream continuity and backpressure",
      "description": "WatchSandbox reconnects, explicit source-gap warnings, discovery failures, and backpressure retries. Any non-zero source-gap warning is evidence that the stream is not durable.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"openshell_exporter_stream_reconnects|openshell\\\\.exporter\\\\.stream\\\\.reconnects\",source=~\"$source\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Reconnects"
        },
        {
          "refId": "B",
          "expr": "sum(rate({__name__=~\"openshell_exporter_stream_gap_warnings|openshell\\\\.exporter\\\\.stream\\\\.gap_warnings\",source=~\"$source\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Source-gap warnings"
        },
        {
          "refId": "C",
          "expr": "sum(rate({__name__=~\"openshell_exporter_discovery_failures|openshell\\\\.exporter\\\\.discovery\\\\.failures\",source=~\"$source\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Discovery failures"
        },
        {
          "refId": "D",
          "expr": "sum(rate({__name__=~\"openshell_exporter_stream_backpressure_retries|openshell\\\\.exporter\\\\.stream\\\\.backpressure_retries\",source=~\"$source\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Backpressure retries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Validation and redaction controls",
      "description": "Invalid structural evidence must remain visible. Redactions prove sensitive values were removed before queues and destinations; zero redactions can be normal when no sensitive value was present.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate({__name__=~\"openshell_exporter_records_invalid|openshell\\\\.exporter\\\\.records\\\\.invalid\",source=~\"$source\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Invalid · {{source}}"
        },
        {
          "refId": "B",
          "expr": "sum by (source, profile) (rate({__name__=~\"openshell_exporter_redactions|openshell\\\\.exporter\\\\.redactions\",source=~\"$source\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Redacted · {{source}} · {{profile}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 45,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "total"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "NeMo Relay span flow",
      "description": "Privacy-gated Relay spans accepted, normalized, and sent by the exporter. These metrics are bounded by component and correlation status; they never expose sandbox, session, trace, prompt, response, or tool identifiers.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans{receiver=~\"otlp.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Accepted"
        },
        {
          "refId": "B",
          "expr": "sum by (correlation_status, privacy_mode) (rate({__name__=~\"openshell_exporter_relay_spans|openshell\\\\.exporter\\\\.relay\\\\.spans\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Processed · {{correlation_status}} · privacy {{privacy_mode}}"
        },
        {
          "refId": "C",
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_spans{exporter=~\"$exporter\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Sent · {{exporter}}"
        },
        {
          "refId": "D",
          "expr": "sum(rate(otelcol_receiver_refused_spans{receiver=~\"otlp.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Refused"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "total"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "NeMo Relay privacy and correlation",
      "description": "Relay correlation outcomes and attributes removed by the configured privacy profile. A partial correlation is observable context, not causal proof; removed attributes are intentionally unavailable downstream.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (correlation_status) (rate({__name__=~\"openshell_exporter_relay_spans|openshell\\\\.exporter\\\\.relay\\\\.spans\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Correlation · {{correlation_status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (scope) (rate({__name__=~\"openshell_exporter_relay_attributes_removed|openshell\\\\.exporter\\\\.relay\\\\.attributes_removed\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Attributes removed · {{scope}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_exporter_send_failed_spans{exporter=~\"$exporter\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Delivery failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 45,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "total"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Exporter process resources",
      "description": "CPU and resident memory for the exporter process. Use this view to spot unbounded growth during sustained collection or destination outages.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(otelcol_process_cpu_seconds[$__rate_interval])",
          "legendFormat": "CPU cores"
        },
        {
          "refId": "B",
          "expr": "otelcol_process_memory_rss",
          "legendFormat": "Resident memory"
        }
      ],
