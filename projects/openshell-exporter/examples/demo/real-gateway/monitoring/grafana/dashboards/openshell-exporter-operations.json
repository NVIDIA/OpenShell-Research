        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 53,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max({__name__=~\"openshell_exporter_policy_reconciliation_queue_utilization|openshell\\\\.exporter\\\\.policy\\\\.reconciliation\\\\.queue_utilization\"})",
          "legendFormat": "queue use",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
