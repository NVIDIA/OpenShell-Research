      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Policy reconciliation outcomes",
      "description": "Rates of successful read-only reconciliations, failures, observable queue/snapshot gaps, and notification-versus-snapshot consistency differences.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"openshell_exporter_policy_reconciliations|openshell\\\\.exporter\\\\.policy\\\\.reconciliations\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "successful"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate({__name__=~\"openshell_exporter_policy_reconciliation_failures|openshell\\\\.exporter\\\\.policy\\\\.reconciliation_failures\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "failure · {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate({__name__=~\"openshell_exporter_policy_gap_warnings|openshell\\\\.exporter\\\\.policy\\\\.gap_warnings\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "gap · {{reason}}"
        },
        {
          "refId": "D",
          "expr": "sum by (state) (rate({__name__=~\"openshell_exporter_policy_reconciliation_consistency_gaps|openshell\\\\.exporter\\\\.policy\\\\.reconciliation\\\\.consistency_gaps\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "consistency · {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
