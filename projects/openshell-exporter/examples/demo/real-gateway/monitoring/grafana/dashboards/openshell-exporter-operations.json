          "color": {
            "mode": "thresholds"
          },
          "noValue": "Reconciliation disabled"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
