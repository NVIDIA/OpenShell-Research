  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "# OpenShell Exporter — Operations Command Center\n### Are all evidence lanes observable, flowing, and delivering?\nThis dashboard monitors the **headless exporter**, not agent behavior. Green means the collection and delivery path is moving. Orange or red means investigate source freshness, persistent queues, validation, reconnects, or destination delivery before trusting apparent silence in the SOC."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Healthy evidence lanes",
      "description": "Percentage of configured bounded evidence lanes currently reporting healthy capability state. Waiting, gap-reported, unavailable, and disabled lanes are not counted as healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(max by (source) ({__name__=~\"openshell_exporter_source_health_class|openshell\\\\.exporter\\\\.source\\\\.health_class\",source=~\"$source\"} == bool 2) * on (source) max by (source) ({__name__=~\"openshell_exporter_source_configured|openshell\\\\.exporter\\\\.source\\\\.(configured|enabled)\",source=~\"$source\"})) or vector(0)) / clamp_min(sum(max by (source) ({__name__=~\"openshell_exporter_source_configured|openshell\\\\.exporter\\\\.source\\\\.(configured|enabled)\",source=~\"$source\"})), 1)",
          "legendFormat": "healthy",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Health metric unavailable"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Evidence in selected window",
      "description": "OpenShell records normalized during the dashboard time range. This avoids hiding recent inactivity behind a large process-lifetime counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"openshell_exporter_records_received|openshell\\\\.exporter\\\\.records\\\\.received\",source=~\"$source\"}[$__range])) or vector(0)",
          "legendFormat": "records in range",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000000000
              },
              {
                "color": "red",
                "value": 1000000001
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Delivery success · 5m",
      "description": "Percentage of CloudEvents delivery responses in the last five minutes that were successful. No delivery traffic is shown as no data rather than a false success.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate({__name__=~\"openshell_exporter_delivery_events|openshell\\\\.exporter\\\\.delivery\\\\.events\",status_code=~\"2..\"}[5m])) / clamp_min(sum(rate({__name__=~\"openshell_exporter_delivery_events|openshell\\\\.exporter\\\\.delivery\\\\.events\"}[5m])), 0.000000001)",
          "legendFormat": "success",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Highest queue use",
      "description": "Largest persistent exporter queue as a percentage of configured capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 * otelcol_exporter_queue_size{exporter=~\"$exporter\"} / clamp_min(otelcol_exporter_queue_capacity{exporter=~\"$exporter\"}, 1)) or vector(0)",
          "legendFormat": "queue",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Stalest source activity",
      "description": "Seconds since the least-recently active observed source. This exposes a stale lane even when another source is still healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(1, max by (source) (time() - {__name__=~\"openshell_exporter_source_last_success_unixtime|openshell\\\\.exporter\\\\.source\\\\.last_success_unixtime\",source=~\"$source\"}))",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Waiting"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Attention signals · 1h",
      "description": "Invalid evidence, source-gap warnings, discovery failures, and failed exports observed in the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase({__name__=~\"openshell_exporter_records_invalid|openshell\\\\.exporter\\\\.records\\\\.invalid\"}[1h])) or vector(0)) + (sum(increase({__name__=~\"openshell_exporter_stream_gap_warnings|openshell\\\\.exporter\\\\.stream\\\\.gap_warnings\"}[1h])) or vector(0)) + (sum(increase({__name__=~\"openshell_exporter_discovery_failures|openshell\\\\.exporter\\\\.discovery\\\\.failures\"}[1h])) or vector(0)) + (sum(increase(otelcol_exporter_send_failed_log_records[1h])) or vector(0)) + (sum(increase(otelcol_exporter_send_failed_spans[1h])) or vector(0))",
          "legendFormat": "signals",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Evidence intake rate by source",
      "description": "Normalized records per second. A flat line is expected only when the corresponding source is genuinely idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, validation_status) (rate({__name__=~\"openshell_exporter_records_received|openshell\\\\.exporter\\\\.records\\\\.received\",source=~\"$source\"}[$__rate_interval]))",
          "legendFormat": "{{source}} · {{validation_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Persistent queue utilization",
      "description": "Current retry-queue occupancy. Sustained growth means a destination is slow or unavailable; file checkpoints and independent queues protect durable lanes while storage remains available.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * otelcol_exporter_queue_size{exporter=~\"$exporter\"} / clamp_min(otelcol_exporter_queue_capacity{exporter=~\"$exporter\"}, 1)",
          "legendFormat": "{{exporter}} · {{data_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Source capability health",
      "description": "Every bounded source lane: Disabled, Waiting for first record, Healthy, Gap reported, or Unavailable. WatchEvents remains explicitly unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"openshell_exporter_source_health_class|openshell\\\\.exporter\\\\.source\\\\.health_class\",source=~\"$source\"}",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 4,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "gray",
                  "index": 0
                },
                "1": {
                  "text": "Waiting for first record",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "Gap reported",
                  "color": "red",
                  "index": 3
                },
                "4": {
                  "text": "Unavailable",
                  "color": "gray",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              },
              {
                "color": "gray",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Health metric unavailable"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Destination delivery rate",
      "description": "CloudEvents delivery responses per second by HTTP status. Non-2xx responses require destination-path investigation; latency is shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 4,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate({__name__=~\"openshell_exporter_delivery_events|openshell\\\\.exporter\\\\.delivery\\\\.events\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
