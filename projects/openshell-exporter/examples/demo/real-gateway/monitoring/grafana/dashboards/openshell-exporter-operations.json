          },
          "noValue": "No durable state yet"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Destination latency percentiles",
      "description": "CloudEvents destination latency percentiles in milliseconds. Sustained p95 or p99 growth can indicate downstream throttling, outage recovery, or queue drain.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 4,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"openshell_exporter_destination_latency_bucket|openshell\\\\.exporter\\\\.destination\\\\.latency_bucket\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"openshell_exporter_destination_latency_bucket|openshell\\\\.exporter\\\\.destination\\\\.latency_bucket\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"openshell_exporter_destination_latency_bucket|openshell\\\\.exporter\\\\.destination\\\\.latency_bucket\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "noValue": "No delivery traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Policy snapshot freshness",
      "description": "Seconds since read-only policy reconciliation was configured or last completed successfully. This is downstream context freshness, not policy authority.",
      "datasource": {
        "type": "prometheus",
        "uid": "openshell-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max({__name__=~\"openshell_exporter_policy_reconciliation_age_seconds|openshell\\\\.exporter\\\\.policy\\\\.reconciliation\\\\.age_seconds\"})",
          "legendFormat": "snapshot age",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
