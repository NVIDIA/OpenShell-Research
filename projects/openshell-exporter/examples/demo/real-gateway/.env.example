# Do not commit a real value. Export it in your shell when starting the demo:
NVIDIA_API_KEY=nvapi-replace-with-build.nvidia.com-key

# Optional: override the one real Hermes task run by run.sh.
HERMES_DEMO_PROMPT=Inspect the sandbox with terminal tools and summarize its security boundaries.

# Non-secret/placeholder values used only for `docker compose config` checks.
# run.sh writes real local values to ignored runtime/demo.env.
DEMO_GATEWAY_DATA_DIR=/tmp/openshell-exporter-real-demo
DEMO_DOCKER_SOCKET=/var/run/docker.sock
DEMO_UID=1000
DEMO_GID=1000
NEMO_RELAY_OTLP_TOKEN=replace-with-32-byte-source-token
WEBAPP_INGEST_TOKEN=replace-with-32-byte-destination-token
OPENSHELL_DEMO_SANDBOX_ID=replace-after-sandbox-create
