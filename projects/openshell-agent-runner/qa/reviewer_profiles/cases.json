        "focus": "src/orders.py and directly related tests only.",
        "context": "Prototype used by one internal team. Extensibility, compatibility layers, and unrelated cleanup are explicit non-goals."
      },
      "coverage": ["repository", "scope constraint", "ambition calibration", "anti-overengineering", "adjacent evidence"],
      "expect": {
        "verdict_in": ["needs_changes"],
        "score_max": 89,
        "findings_min": 1,
        "required_any": [["empty", "zero items", "reduce"]],
        "forbidden": ["plugin architecture", "compatibility layer", "microservice", "dependency injection framework"]
      }
