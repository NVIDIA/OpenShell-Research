# Existing gateway name, already configured in your installed OpenShell CLI.
OPENSHELL_GATEWAY=your-gateway
# Ask your gateway operator for its public Ed25519 signing key and exact issuer.
# Never use the private signing key or the gateway TLS certificate here.
OPENSHELL_GATEWAY_PUBLIC_KEY=/absolute/path/to/gateway-public.pem
OPENSHELL_GATEWAY_ISSUER=openshell-gateway:openshell
# Egress Gate hostname or IPv4 address reachable from gateway AND sandbox.
# Docker Desktop commonly uses host.docker.internal; Linux can use the bridge IP.
EGRESS_GATE_HOST=host.docker.internal
# Real key for the HTTPS endpoint/model in model.json. Never copied into the image.
PI_MODEL_API_KEY=your-provider-key
