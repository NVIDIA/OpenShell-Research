# Existing HTTPS/mTLS gateway registered in your OpenShell CLI (gateway list).
OPENSHELL_GATEWAY=your-gateway
# Egress Gate hostname or IPv4 address reachable from gateway AND sandbox.
# Docker Desktop commonly uses host.docker.internal; Linux can use the bridge IP.
EGRESS_GATE_HOST=host.docker.internal
# Real key for the HTTPS endpoint/model in model.json. Never copied into the image.
PI_MODEL_API_KEY=your-provider-key
