{
  "id": "YOUR_MODEL_ID",
  "name": "Your model",
  "provider": "pi-egress",
  "api": "openai-completions",
  "baseUrl": "https://api.example.com/v1",
  "reasoning": false,
  "input": ["text"],
  "contextWindow": 128000,
  "maxTokens": 4096,
