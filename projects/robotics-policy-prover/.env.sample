# Required only for model-backed planning. Fixture mode needs no credentials.
OPENAI_API_KEY=

# The official OpenAI URL uses the Responses API. Other OpenAI-compatible URLs
# use the /chat/completions endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred model setting. If omitted, the service checks LLM_MODEL, then
# FAST_MODEL, and finally defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# LLM_MODEL=
# FAST_MODEL=

# Optional. The secure default is 127.0.0.1:8787.
# POLICY_PROVER_BIND_ADDR=127.0.0.1:8787
